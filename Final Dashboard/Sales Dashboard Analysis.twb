          <datasource-dependencies datasource='federated.06ch0y21drb43v1fzddnq0qompwj'>
            <column caption='{SUM([CY Sales])}' datatype='real' name='[Calculation_1075940228800512]' role='measure' type='quantitative' user:unnamed='KPI'>
              <calculation class='tableau' formula='{SUM([Calculation_1465981908852743])}' />
            </column>
            <column caption='{[% Diff Sales]}' datatype='real' name='[Calculation_1075940228845569]' role='measure' type='quantitative' user:unnamed='KPI'>
