            <column caption='% Diff Sales' datatype='real' default-format='*▲ 0.0%; ▼ -0.0%;' name='[Calculation_1465981909827601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1465981908852743])-SUM([Calculation_1465981909405708]))/SUM([Calculation_1465981909405708])' />
