              <calculation class='tableau' formula='IF SUM([Calculation_1465981908852743]) = WINDOW_MAX(SUM([Calculation_1465981908852743]))&#13;&#10;THEN SUM([Calculation_1465981908852743])&#13;&#10;ELSEIF SUM([Calculation_1465981908852743]) = WINDOW_MIN(SUM([Calculation_1465981908852743]))&#13;&#10;THEN SUM([Calculation_1465981908852743])&#13;&#10;END'>
